<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"] | CineBox</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head>
<body><header><nav class="navwrap"><a class="brand" asp-area="" asp-controller="Movies" asp-action="Index">CINE<span>BOX</span><small> / FILM STORE</small></a><div class="links"><a asp-area="" asp-controller="Movies" asp-action="Index">Cửa hàng</a>@if(User.Identity?.IsAuthenticated == true){<a asp-area="" asp-controller="Movies" asp-action="Manage">Quản lý phim</a><a asp-area="" asp-controller="Genres" asp-action="Index">Thể loại</a>}</div><partial name="_LoginPartial" /></nav></header><main class="shell">@if(TempData["Message"]!=null){<div class="alert alert-warning">@TempData["Message"]</div>}@RenderBody()</main><footer><div class="shell">CINEBOX · Bài thực hành ASP.NET Core MVC <br> &copy; @DateTime.Now.Year – 31241021966 – Bùi Công Danh</div></footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
