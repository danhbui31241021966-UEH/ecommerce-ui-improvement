@model Movie
@{ViewData["Title"]="Thêm phim";}<h1>Thêm phim</h1><form asp-action="Create" method="post" enctype="multipart/form-data" class="panel formpanel"><div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Title"></label><input asp-for="Title" class="form-control"><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Summary"></label><textarea asp-for="Summary" class="form-control" rows="3"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ReleaseDate"></label><input asp-for="ReleaseDate" class="form-control"><span asp-validation-for="ReleaseDate" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Genre"></label><input asp-for="Genre" class="form-control"><span asp-validation-for="Genre" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="GenreID"></label><select asp-for="GenreID" asp-items="ViewBag.GenreID" class="form-select"><option value="">Chọn thể loại</option></select><small>Nhập mã ID tương ứng với thể loại đã tạo trong trang Thể loại.</small><span asp-validation-for="GenreID" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Price"></label><input asp-for="Price" type="number" min="5000" step="1" class="form-control"><span asp-validation-for="Price" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Rated"></label><input asp-for="Rated" type="number" min="1" max="5" step="0.1" class="form-control"><span asp-validation-for="Rated" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="PictureUpload"></label><input asp-for="PictureUpload" type="file" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control"><span asp-validation-for="PictureUpload" class="text-danger"></span></div><button class="btn btn-primary">Lưu</button> <a asp-action="Manage" class="btn btn-outline-light">Quay lại</a></form>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
