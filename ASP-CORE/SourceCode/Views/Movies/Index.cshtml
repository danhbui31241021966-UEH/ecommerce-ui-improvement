@model IEnumerable<Movie>
@{ ViewData["Title"]="Cửa hàng phim"; }
<section class="hero"><div><p class="eyebrow">CINEBOX / BỘ SƯU TẬP 2027</p><h1>Điện ảnh.<br><span>Trong tầm tay.</span></h1><p>Khám phá các bộ phim được tuyển chọn, từ những chuyến phiêu lưu đến câu chuyện đầy cảm xúc.</p><a class="btn btn-primary" href="#catalog">Khám phá bộ sưu tập</a></div><div class="heroart"><span>CB</span><small>THE MOVIE COLLECTION</small></div></section>
<div class="sectionhead" id="catalog"><div><p class="eyebrow">DANH MỤC</p><h2>Phim nổi bật</h2><p class="muted">31241021966 – Bùi Công Danh</p></div><form method="get" class="filters"><input name="q" value="@ViewBag.Q" placeholder="Tìm phim..." aria-label="Tìm phim"><select name="genre" asp-items="ViewBag.Genres" aria-label="Thể loại"><option value="">Tất cả thể loại</option></select><button class="btn btn-outline-light">Tìm</button></form></div>
@if(!Model.Any()){<p class="panel">Chưa có phim phù hợp. Đăng nhập để thêm thể loại và sản phẩm.</p>}
<div class="moviegrid">@foreach(var item in Model){<article class="moviecard"><a asp-action="Details" asp-route-id="@item.ID"><img src="@(item.PicturePath ?? "/images/no-image.jpg")" alt="@item.Title"></a><div class="moviebody"><div class="meta"><span>@item.GenreObj?.Name</span><span>★ @item.Rated / 5</span></div><h3>@item.Title</h3><p class="muted">Phát hành: @item.ReleaseDate.ToString("dd/MM/yyyy")</p><p>@item.Summary</p><div class="buyrow"><strong>@item.Price.ToString("N0") đ</strong><form asp-action="AddToCart" asp-route-id="@item.ID" method="post"><button class="btn btn-primary">Mua</button></form></div></div></article>}</div>
