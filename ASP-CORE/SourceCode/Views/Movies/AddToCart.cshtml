@model HoaDon
@{ViewData["Title"]="Giỏ hàng";}<h1>Giỏ hàng của bạn</h1>@if(!Model.ChiTietHoaDons.Any()){<p class="panel">Giỏ hàng đang trống.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach(var line in Model.ChiTietHoaDons){<tr><td>@line.MovieObj.Title</td><td><form asp-action="UpdateCart" method="post" class="qty"><input type="hidden" name="id" value="@line.MaMovie"><input name="quantity" type="number" min="1" max="99" value="@line.SoLuong" aria-label="Số lượng"><button class="btn btn-outline-light btn-sm">Cập nhật</button></form></td><td>@line.DonGia.ToString("N0") đ</td><td>@((line.SoLuong*line.DonGia).ToString("N0")) đ</td><td><form asp-action="RemoveFromCart" method="post"><input name="maMovies" value="@line.MaMovie" type="hidden"><button class="btn btn-outline-danger btn-sm">Xóa</button></form></td></tr>}</tbody><tfoot><tr><th colspan="3">Tổng tiền (Total)</th><th colspan="2">@Model.TongTien.ToString("N0") đ</th></tr></tfoot></table></div><a class="btn btn-primary" asp-action="Checkout">Checkout now</a>} <a class="btn btn-outline-light" asp-action="Index">Tiếp tục mua</a>
