@model IEnumerable<Movie>
@{ViewData["Title"]="Quản lý sản phẩm";}<div class="sectionhead"><h1>Quản lý sản phẩm</h1><a class="btn btn-primary" asp-action="Create">+ Thêm phim</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Ảnh</th><th>Tiêu đề</th><th>Thể loại</th><th>Giá</th><th>Ngày phát hành</th><th>Thao tác</th></tr></thead><tbody>@foreach(var m in Model){<tr><td><img class="thumb" src="@m.PicturePath" alt="@m.Title"></td><td>@m.Title</td><td>@m.GenreObj?.Name</td><td>@m.Price.ToString("N0") đ</td><td>@m.ReleaseDate.ToString("dd/MM/yyyy")</td><td><a asp-action="Details" asp-route-id="@m.ID">Xem</a> · <a asp-action="Edit" asp-route-id="@m.ID">Sửa</a> · <a asp-action="Delete" asp-route-id="@m.ID">Xóa</a></td></tr>}</tbody></table></div>
